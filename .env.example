NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Leave blank for the zero-setup in-memory demo. Set this to enable MongoDB persistence.
MONGO_URI=
# Set a random value and configure the same x-callkaro-secret header for webhook requests.
# No CallKaro signature scheme is assumed until verified against official documentation.
CALLKARO_WEBHOOK_SECRET=
# Comma-separated exact origins. Empty means same-origin requests only.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
